---
import { CurvyRightDirectionFreeIcons } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { Icon } from "astro-icon/components"

import { buttonVariants } from "@/lib/variants"
---

<header class="absolute top-0 z-50 h-24 w-full">
  <nav class="container mx-auto flex h-full items-center justify-between">
    <a href="/">
      <Icon name="logo" class="size-12 md:size-14" aria-hidden />
      <span class="sr-only">Página de inicio</span>
    </a>
    <div class="flex h-full items-center justify-end">
      <a href="#" class={buttonVariants()}>
        Contáctanos
        <HugeiconsIcon icon={CurvyRightDirectionFreeIcons} />
      </a>
    </div>
  </nav>
</header>
