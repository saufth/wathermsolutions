---
import { ArrowRight01Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { Icon } from "astro-icon/components"

import { buttonVariants } from "@/lib/variants"
---

<header class="absolute top-0 z-50 h-24 w-full">
  <nav
    class="relative container mx-auto flex h-full items-center justify-between"
  >
    <Icon
      name="blob"
      class="absolute -top-36 -left-36 -z-10 hidden size-80 md:block md:size-88 xl:-left-32"
      aria-hidden
    />
    <a href="/">
      <Icon name="logo" class="size-12 md:size-14" aria-hidden />
      <span class="sr-only">Página de inicio</span>
    </a>
    <div class="flex h-full items-center justify-end">
      <a href="#" class={buttonVariants({ size: "sm" })}>
        Contáctanos
        <HugeiconsIcon icon={ArrowRight01Icon} />
      </a>
    </div>
  </nav>
</header>
